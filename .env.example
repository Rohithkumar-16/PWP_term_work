# Flask / Application Security
SECRET_KEY=
FLASK_ENV=development
PORT=5000

# Database (defaults to local SQLite; set postgresql://... for production)
DATABASE_URL=sqlite:///hotel.db

# Seeded Demo Accounts (change ADMIN_PASSWORD before deploying to production)
ADMIN_EMAIL=admin@halcyonhotel.com
ADMIN_PASSWORD=
GUEST_EMAIL=guest@halcyonhotel.com
GUEST_PASSWORD=

# AI Studio Runtime Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
